---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="preview" style="padding: 60px 0 120px;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px 40px;">
      <a href="/matsola-family/" style="display: inline-block; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cream-4); text-decoration: none; margin-bottom: 24px;">← На головну</a>
      <h1 style="font-family: var(--display); font-style: italic; font-size: clamp(40px, 5vw, 64px); color: var(--cream); margin: 0 0 12px; font-weight: 500;">Trust-strip · варіанти</h1>
      <p style="color: var(--cream-3); font-size: 16px; max-width: 640px; margin: 0;">Вибери один — застосую його до основного сайту і видалю цю сторінку. Поточний варіант знизу для порівняння.</p>
    </div>

    <!-- Variant 1: Big stat numbers -->
    <section class="v-wrap" data-v="1">
      <p class="v-label">Варіант 1 · Великі цифри (Apple-style)</p>
      <div class="v-stats">
        <div class="v-stat"><span class="v-stat-n">71%</span><span class="v-stat-l">Білків у слайсах</span></div>
        <div class="v-divider"></div>
        <div class="v-stat"><span class="v-stat-n">0г</span><span class="v-stat-l">Вуглеводів</span></div>
        <div class="v-divider"></div>
        <div class="v-stat"><span class="v-stat-n">4–5</span><span class="v-stat-l">Інгредієнтів</span></div>
        <div class="v-divider"></div>
        <div class="v-stat"><span class="v-stat-n">100%</span><span class="v-stat-l">Натуральне м'ясо</span></div>
      </div>
    </section>

    <!-- Variant 2: Editorial monospace tags -->
    <section class="v-wrap" data-v="2">
      <p class="v-label">Варіант 2 · Editorial monospace (Bauhaus / brutalist)</p>
      <div class="v-edit">
        <span class="v-edit-i">71% Білків</span>
        <span class="v-edit-d">—</span>
        <span class="v-edit-i">Натуральне копчення</span>
        <span class="v-edit-d">—</span>
        <span class="v-edit-i">Без сої</span>
        <span class="v-edit-d">—</span>
        <span class="v-edit-i">Без ГМО</span>
        <span class="v-edit-d">—</span>
        <span class="v-edit-i">Чесний склад</span>
      </div>
    </section>

    <!-- Variant 3: Minimal inline (Linear / Vercel) -->
    <section class="v-wrap" data-v="3">
      <p class="v-label">Варіант 3 · Minimal inline (Linear / Vercel-style)</p>
      <div class="v-min">
        <span class="v-min-i"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5l2.5 2.5L10 4"/></svg>71% Білків</span>
        <span class="v-min-sep">·</span>
        <span class="v-min-i"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5l2.5 2.5L10 4"/></svg>Натуральне копчення</span>
        <span class="v-min-sep">·</span>
        <span class="v-min-i"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5l2.5 2.5L10 4"/></svg>Без сої</span>
        <span class="v-min-sep">·</span>
        <span class="v-min-i"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5l2.5 2.5L10 4"/></svg>Без ГМО</span>
        <span class="v-min-sep">·</span>
        <span class="v-min-i"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5l2.5 2.5L10 4"/></svg>Чесний склад</span>
      </div>
    </section>

    <!-- Variant 4: Glass cards -->
    <section class="v-wrap" data-v="4">
      <p class="v-label">Варіант 4 · Glass cards (premium / luxury)</p>
      <div class="v-glass-row">
        <div class="v-glass"><div class="v-glass-num">71%</div><div class="v-glass-cap">Білків</div></div>
        <div class="v-glass"><div class="v-glass-num">100%</div><div class="v-glass-cap">М'ясо</div></div>
        <div class="v-glass"><div class="v-glass-num">0г</div><div class="v-glass-cap">Вуглеводів</div></div>
        <div class="v-glass"><div class="v-glass-num">✓</div><div class="v-glass-cap">Без сої</div></div>
        <div class="v-glass"><div class="v-glass-num">✓</div><div class="v-glass-cap">Без ГМО</div></div>
      </div>
    </section>

    <!-- Variant 5: Gradient ribbon -->
    <section class="v-wrap" data-v="5">
      <p class="v-label">Варіант 5 · Gradient ribbon (cinematic)</p>
      <div class="v-ribbon">
        <div class="v-ribbon-row">
          <span class="v-ribbon-w"><strong>71%</strong> Білків</span>
          <span class="v-ribbon-w"><strong>0г</strong> Вуглеводів</span>
          <span class="v-ribbon-w">Натуральне <strong>копчення</strong></span>
          <span class="v-ribbon-w">Без <strong>сої</strong></span>
          <span class="v-ribbon-w">Без <strong>ГМО</strong></span>
        </div>
      </div>
    </section>

    <!-- Current: pills -->
    <section class="v-wrap" data-v="0">
      <p class="v-label">Поточний · Pill badges (на сайті зараз)</p>
      <ul class="trust-row" style="border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: var(--ink); padding: 28px 20px;">
        <li class="trust-pill"><svg class="trust-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.6"/></svg><span>71% Білків</span></li>
        <li class="trust-pill"><svg class="trust-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.2l1.7 4.3 4.6.35-3.5 3 1.1 4.5L8 11l-3.9 2.35 1.1-4.5-3.5-3 4.6-.35L8 1.2z"/></svg><span>Натуральне копчення</span></li>
        <li class="trust-pill"><svg class="trust-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.5l5.5 2v4.7c0 3.1-2.3 5.6-5.5 6.3-3.2-.7-5.5-3.2-5.5-6.3V3.5L8 1.5z"/></svg><span>Без сої</span></li>
        <li class="trust-pill"><svg class="trust-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.6"/></svg><span>Без ГМО</span></li>
        <li class="trust-pill"><svg class="trust-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.2l1.7 4.3 4.6.35-3.5 3 1.1 4.5L8 11l-3.9 2.35 1.1-4.5-3.5-3 4.6-.35L8 1.2z"/></svg><span>Чесний склад</span></li>
      </ul>
    </section>

  </main>
</Layout>

<style>
  .v-wrap { margin: 28px 0; }
  .v-label {
    max-width: 1200px; margin: 0 auto 14px; padding: 0 24px;
    font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--cream-4); font-weight: 700;
  }

  /* Variant 1: Big stat numbers */
  .v-stats {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--ink);
    padding: 36px 20px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 18px 32px;
  }
  .v-stat { display: inline-flex; flex-direction: column; align-items: center; gap: 6px; }
  .v-stat-n {
    font-family: var(--display); font-style: italic;
    font-size: clamp(34px, 4vw, 48px); line-height: 1;
    color: var(--accent); font-weight: 500;
  }
  .v-stat-l {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--cream-3); font-weight: 600;
  }
  .v-divider {
    width: 1px; height: 40px; background: var(--rule);
  }
  @media (max-width: 700px) { .v-divider { display: none; } }

  /* Variant 2: Editorial monospace */
  .v-edit {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--black);
    padding: 22px 20px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 6px 14px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
  .v-edit-i {
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cream-2); font-weight: 600;
  }
  .v-edit-d { color: var(--accent); font-size: 14px; }

  /* Variant 3: Minimal inline */
  .v-min {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--ink);
    padding: 18px 20px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 8px 12px;
  }
  .v-min-i {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--cream-2); font-weight: 500;
    letter-spacing: 0.02em;
  }
  .v-min-i svg { width: 14px; height: 14px; color: var(--green); flex-shrink: 0; }
  .v-min-sep { color: var(--cream-4); font-size: 13px; }

  /* Variant 4: Glass cards */
  .v-glass-row {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--ink);
    padding: 32px 20px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    max-width: 1200px; margin: 0 auto;
    gap: 14px;
  }
  .v-glass {
    text-align: center;
    padding: 22px 12px;
    border: 1px solid var(--rule);
    background: linear-gradient(180deg, rgba(232, 220, 196, 0.04), rgba(232, 220, 196, 0.01));
    backdrop-filter: blur(4px);
    border-radius: 8px;
    transition: transform .25s ease, border-color .25s ease;
  }
  .v-glass:hover { transform: translateY(-3px); border-color: rgba(229, 133, 66, 0.4); }
  .v-glass-num {
    font-family: var(--display); font-style: italic;
    font-size: 38px; line-height: 1; color: var(--accent); font-weight: 500;
    margin-bottom: 8px;
  }
  .v-glass-cap {
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--cream-3); font-weight: 700;
  }
  @media (max-width: 760px) {
    .v-glass-row { grid-template-columns: repeat(2, 1fr); }
    .v-glass-num { font-size: 30px; }
  }

  /* Variant 5: Gradient ribbon */
  .v-ribbon {
    background: linear-gradient(135deg, var(--ink) 0%, var(--ink-2) 50%, var(--ink) 100%);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    position: relative;
    overflow: hidden;
  }
  .v-ribbon::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(229, 133, 66, 0.12), transparent 50%),
                radial-gradient(circle at 70% 50%, rgba(122, 176, 130, 0.08), transparent 50%);
    pointer-events: none;
  }
  .v-ribbon-row {
    position: relative;
    padding: 36px 24px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 12px 36px;
    max-width: 1200px; margin: 0 auto;
  }
  .v-ribbon-w {
    font-family: var(--display);
    font-size: clamp(18px, 2vw, 24px);
    color: var(--cream-2); font-weight: 500;
    letter-spacing: 0.01em;
  }
  .v-ribbon-w strong {
    color: var(--accent); font-style: italic; font-weight: 600; margin-right: 4px;
  }
</style>
