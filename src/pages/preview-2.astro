---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="pv" style="padding: 60px 0 120px;">
    <div class="pv-head">
      <a href="/matsola-family/" class="pv-back">← На головну</a>
      <h1>Products · варіанти</h1>
      <p class="pv-desc">5 варіантів асортименту. Поточний — внизу.</p>
      <nav class="pv-nav">
        <a href="/matsola-family/preview-1/">1·Hero</a>
        <a href="/matsola-family/preview-2/" class="on">2·Products</a>
        <a href="/matsola-family/preview-3/">3·Nutrition</a>
        <a href="/matsola-family/preview-4/">4·Protein+Moments</a>
        <a href="/matsola-family/preview-5/">5·Founder</a>
        <a href="/matsola-family/preview-6/">6·Cta</a>
      </nav>
    </div>

    <!-- V1: Horizontal scroll-snap carousel -->
    <section class="pv-v" data-v="1">
      <p class="pv-label">Варіант 1 · Horizontal scroll-snap карусель</p>
      <div class="p1-wrap">
        <div class="p1-head">
          <p class="p1-eye">— Асортимент</p>
          <h2>Два снеки.<br><em>Жодних компромісів.</em></h2>
          <p class="p1-hint">→ Прокрути праворуч</p>
        </div>
        <div class="p1-rail">
          <article class="p1-card">
            <div class="p1-img p1-img-chicken">71%</div>
            <div class="p1-tag g">високий білок</div>
            <h3>Курячі Слайси</h3>
            <p>З грецькими травами · 30г · 340 ккал</p>
            <a class="pv-btn pv-btn-acc">Купити</a>
          </article>
          <article class="p1-card">
            <div class="p1-img p1-img-cab">24г</div>
            <div class="p1-tag a">4 смаки</div>
            <h3>Кабаноси</h3>
            <p>Натуральне копчення · 80г · 450 ккал</p>
            <a class="pv-btn pv-btn-acc">Купити</a>
          </article>
          <article class="p1-card">
            <div class="p1-img p1-img-soon">soon</div>
            <div class="p1-tag b">скоро</div>
            <h3>Друга хвиля</h3>
            <p>Ковбаски · Сосиски · Smoke house</p>
            <a class="pv-btn">Чекати</a>
          </article>
        </div>
      </div>
    </section>

    <!-- V2: Image cards stacked vertically -->
    <section class="pv-v" data-v="2">
      <p class="pv-label">Варіант 2 · Stacked image cards (full-width)</p>
      <div class="p2-wrap">
        <article class="p2-card">
          <div class="p2-img p2-img-chicken"></div>
          <div class="p2-overlay">
            <div class="p2-meta"><span>01</span><span>·</span><span>Курячі Слайси</span></div>
            <h3>з грецькими травами</h3>
            <p>71% білка, нуль вуглеводів. Снек після якого не шукаєш виправдань.</p>
            <a class="pv-btn pv-btn-acc">Купити →</a>
          </div>
        </article>
        <article class="p2-card">
          <div class="p2-img p2-img-cab"></div>
          <div class="p2-overlay">
            <div class="p2-meta"><span>02</span><span>·</span><span>Кабаноси</span></div>
            <h3>чотири характери</h3>
            <p>Класичні · Гострі · З пармезаном · Особливі. Копчення на твердих породах деревини.</p>
            <a class="pv-btn pv-btn-acc">Купити →</a>
          </div>
        </article>
      </div>
    </section>

    <!-- V3: Spec sheet (deli menu) -->
    <section class="pv-v" data-v="3">
      <p class="pv-label">Варіант 3 · Spec sheet (deli menu style)</p>
      <div class="p3-wrap">
        <div class="p3-head">
          <p>— Asortiment 2025 —</p>
          <h2>Дві позиції.<br>Один стандарт.</h2>
        </div>
        <div class="p3-table">
          <div class="p3-row">
            <div class="p3-num">№ 01</div>
            <div class="p3-name">
              <h3>Курячі Слайси</h3>
              <p>з грецькими травами</p>
            </div>
            <div class="p3-data">
              <span>Білки <b>71%</b></span>
              <span>Ккал <b>340</b></span>
              <span>Вага <b>30 г</b></span>
            </div>
            <a class="pv-btn pv-btn-acc">Купити</a>
          </div>
          <div class="p3-row">
            <div class="p3-num">№ 02</div>
            <div class="p3-name">
              <h3>Кабаноси</h3>
              <p>4 смаки · копчені</p>
            </div>
            <div class="p3-data">
              <span>Білки <b>24 г</b></span>
              <span>Ккал <b>450</b></span>
              <span>Вага <b>80 г</b></span>
            </div>
            <a class="pv-btn pv-btn-acc">Купити</a>
          </div>
        </div>
      </div>
    </section>

    <!-- V4: Toggle tabs (one big product, switcher) -->
    <section class="pv-v" data-v="4">
      <p class="pv-label">Варіант 4 · Toggle tabs (один продукт у фокусі)</p>
      <div class="p4-wrap">
        <div class="p4-tabs">
          <button class="on">Курячі Слайси</button>
          <button>Кабаноси</button>
        </div>
        <div class="p4-grid">
          <div class="p4-visual">
            <div class="p4-hero">
              <div class="p4-num">71%</div>
              <div class="p4-name">КУРЯЧІ СЛАЙСИ</div>
              <div class="p4-meta">з грецькими травами · 30 г</div>
            </div>
          </div>
          <div class="p4-info">
            <h3>Курячі Слайси<br><em>з грецькими травами</em></h3>
            <p class="p4-desc">Тонка нарізка курячого філе, підсушена з грецькими травами. 71% білка, нуль вуглеводів.</p>
            <div class="p4-facts">
              <div><div class="k">Білків</div><div class="v">71%</div></div>
              <div><div class="k">Ккал</div><div class="v">340</div></div>
              <div><div class="k">Вага</div><div class="v">30 г</div></div>
            </div>
            <a class="pv-btn pv-btn-acc">Де купити →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- V5: Polaroid tilt cards -->
    <section class="pv-v" data-v="5">
      <p class="pv-label">Варіант 5 · Polaroid tilt (editorial / handcraft)</p>
      <div class="p5-wrap">
        <div class="p5-head">
          <p>— Made by hand —</p>
          <h2>Два снеки.<br><em>Один характер.</em></h2>
        </div>
        <div class="p5-row">
          <div class="p5-polaroid p5-tilt-l">
            <div class="p5-img p5-img-chicken">71%</div>
            <p class="p5-cap">Курячі Слайси</p>
            <p class="p5-sub">з грецькими травами</p>
          </div>
          <div class="p5-polaroid p5-tilt-r">
            <div class="p5-img p5-img-cab">24г</div>
            <p class="p5-cap">Кабаноси</p>
            <p class="p5-sub">класичні · копчені</p>
          </div>
        </div>
        <p class="p5-foot">— Виробництво в Україні · ППБ з 2004 —</p>
      </div>
    </section>

    <!-- Current -->
    <section class="pv-v" data-v="0">
      <p class="pv-label">Поточний · Lineup grid з 3D-пачкою (на сайті зараз)</p>
      <div class="p0-wrap">
        <article class="p0-row">
          <div class="p0-visual">
            <div class="p0-pack">
              <div class="p0-brand">Matsola</div>
              <div class="p0-fam">— FAMILY —</div>
              <div class="p0-window p0-window-chicken"></div>
              <div class="p0-info"><span>71% білків</span><span>30 г</span></div>
              <div class="p0-title">КУРЯЧІ СЛАЙСИ</div>
            </div>
          </div>
          <div class="p0-content">
            <p class="p0-label">— з грецькими травами</p>
            <h3>Курячі<br><em>Слайси.</em></h3>
            <p class="p0-lead">Тонка нарізка курячого філе.</p>
            <div class="p0-specs"><span><b>71%</b> Білків</span><span><b>30 г</b> Вага</span><span><b>340</b> Ккал</span></div>
            <a class="pv-btn pv-btn-acc">Де купити</a>
          </div>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Shared preview chrome */
  .pv-head { max-width: 1200px; margin: 0 auto 40px; padding: 0 24px; }
  .pv-back { display: inline-block; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cream-4); text-decoration: none; margin-bottom: 24px; }
  .pv-head h1 { font-family: var(--display); font-style: italic; font-size: clamp(36px, 5vw, 56px); color: var(--cream); margin: 0 0 12px; font-weight: 500; }
  .pv-desc { color: var(--cream-3); font-size: 16px; max-width: 640px; margin: 0 0 24px; }
  .pv-nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .pv-nav a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--rule); border-radius: 999px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cream-3); text-decoration: none; background: var(--ink); transition: all .2s; }
  .pv-nav a:hover { color: var(--cream); border-color: rgba(232,220,196,0.35); }
  .pv-nav a.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .pv-v { margin: 40px 0; }
  .pv-label { max-width: 1200px; margin: 0 auto 14px; padding: 0 24px; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--cream-4); font-weight: 700; }
  .pv-btn { display: inline-flex; align-items: center; padding: 11px 20px; border: 1px solid var(--rule); border-radius: 4px; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cream); font-weight: 600; cursor: pointer; transition: all .2s; text-decoration: none; }
  .pv-btn:hover { border-color: var(--cream); }
  .pv-btn-acc { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pv-btn-acc:hover { background: var(--accent-deep); border-color: var(--accent-deep); }

  /* V1: Carousel */
  .p1-wrap { background: var(--ink); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 60px 0; }
  .p1-head { max-width: 1200px; margin: 0 auto 40px; padding: 0 24px; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 24px; }
  .p1-eye { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--cream-4); margin: 0 0 8px; font-weight: 700; }
  .p1-head h2 { font-family: var(--display); font-size: clamp(36px, 5vw, 56px); line-height: 1; color: var(--cream); margin: 0; font-weight: 500; }
  .p1-head h2 em { font-style: italic; color: var(--accent); }
  .p1-hint { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cream-4); }
  .p1-rail { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 24px 30px; }
  .p1-card { flex: 0 0 320px; scroll-snap-align: start; padding: 32px 26px; background: var(--black); border: 1px solid var(--rule); display: flex; flex-direction: column; gap: 14px; }
  .p1-card:hover { border-color: rgba(229, 133, 66, 0.4); }
  .p1-img { height: 200px; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-style: italic; font-size: 64px; color: var(--accent); font-weight: 500; border-radius: 4px; }
  .p1-img-chicken { background: linear-gradient(135deg, rgba(229,133,66,0.18), rgba(229,133,66,0.04)); }
  .p1-img-cab { background: linear-gradient(135deg, rgba(122,176,130,0.18), rgba(122,176,130,0.04)); color: var(--green); }
  .p1-img-soon { background: linear-gradient(135deg, rgba(232,220,196,0.06), rgba(232,220,196,0.01)); color: var(--cream-4); font-size: 32px; letter-spacing: 0.2em; text-transform: uppercase; font-style: normal; }
  .p1-tag { display: inline-block; align-self: flex-start; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; font-weight: 700; }
  .p1-tag.g { background: rgba(229,133,66,0.12); color: var(--accent); }
  .p1-tag.a { background: rgba(122,176,130,0.12); color: var(--green); }
  .p1-tag.b { background: rgba(232,220,196,0.08); color: var(--cream-3); }
  .p1-card h3 { font-family: var(--display); font-style: italic; font-size: 28px; color: var(--cream); margin: 0; font-weight: 500; }
  .p1-card p { font-size: 13px; color: var(--cream-3); margin: 0; line-height: 1.5; }
  @media (max-width: 700px) { .p1-card { flex-basis: 80%; } }

  /* V2: Stacked image cards */
  .p2-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 24px; }
  .p2-card { position: relative; overflow: hidden; border: 1px solid var(--rule); border-radius: 8px; min-height: 360px; }
  .p2-img { position: absolute; inset: 0; }
  .p2-img-chicken { background:
    radial-gradient(ellipse at 30% 50%, rgba(229,133,66,0.55) 0%, rgba(229,133,66,0.08) 50%, transparent 80%),
    linear-gradient(135deg, #3a2a1a, #1a1612);
  }
  .p2-img-cab { background:
    radial-gradient(ellipse at 70% 50%, rgba(122,80,40,0.7) 0%, rgba(60,30,15,0.4) 50%, transparent 80%),
    linear-gradient(135deg, #261810, #161310);
  }
  .p2-overlay { position: relative; z-index: 1; padding: 50px; max-width: 540px; height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  .p2-meta { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--accent); font-weight: 700; display: flex; gap: 10px; }
  .p2-card h3 { font-family: var(--display); font-size: clamp(36px, 5vw, 56px); color: var(--cream); margin: 0; font-weight: 500; font-style: italic; }
  .p2-card p { font-size: 15px; color: var(--cream-2); line-height: 1.7; max-width: 440px; margin: 0; }
  .p2-card a.pv-btn { align-self: flex-start; }

  /* V3: Spec sheet */
  .p3-wrap { background: var(--black); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 60px 24px; }
  .p3-head { max-width: 1100px; margin: 0 auto 50px; text-align: center; }
  .p3-head p { font-family: ui-monospace, Menlo, monospace; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--cream-4); margin: 0 0 14px; }
  .p3-head h2 { font-family: var(--display); font-size: clamp(34px, 5vw, 52px); line-height: 1; color: var(--cream); margin: 0; font-weight: 500; }
  .p3-table { max-width: 1100px; margin: 0 auto; }
  .p3-row { display: grid; grid-template-columns: 80px 1fr 1fr auto; gap: 24px; align-items: center; padding: 24px 0; border-bottom: 1px dashed var(--rule); }
  .p3-row:first-child { border-top: 1px dashed var(--rule); }
  .p3-num { font-family: var(--display); font-style: italic; font-size: 24px; color: var(--accent); }
  .p3-name h3 { font-family: var(--display); font-style: italic; font-size: 24px; color: var(--cream); margin: 0; font-weight: 500; }
  .p3-name p { font-size: 12px; letter-spacing: 0.1em; color: var(--cream-3); margin: 4px 0 0; }
  .p3-data { display: flex; gap: 20px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cream-3); font-weight: 600; }
  .p3-data b { color: var(--accent); font-family: var(--display); font-style: italic; font-size: 18px; font-weight: 500; margin-left: 4px; }
  @media (max-width: 780px) { .p3-row { grid-template-columns: 60px 1fr; } .p3-data, .p3-row .pv-btn { grid-column: 1 / -1; } }

  /* V4: Toggle tabs */
  .p4-wrap { background: var(--ink); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 50px 24px 60px; }
  .p4-tabs { display: flex; gap: 4px; justify-content: center; margin-bottom: 40px; padding: 4px; background: var(--black); border: 1px solid var(--rule); border-radius: 999px; max-width: 460px; margin-left: auto; margin-right: auto; }
  .p4-tabs button { flex: 1; padding: 12px 20px; border: 0; background: transparent; color: var(--cream-3); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; cursor: pointer; border-radius: 999px; font-family: inherit; transition: all .2s; }
  .p4-tabs button.on { background: var(--accent); color: #fff; }
  .p4-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; }
  .p4-visual { display: flex; justify-content: center; }
  .p4-hero { width: 320px; padding: 50px 32px; background: linear-gradient(180deg, rgba(229,133,66,0.18), rgba(229,133,66,0.04)); border: 1px solid rgba(229,133,66,0.3); border-radius: 8px; text-align: center; }
  .p4-num { font-family: var(--display); font-style: italic; font-size: 88px; line-height: 1; color: var(--accent); font-weight: 500; }
  .p4-name { font-size: 14px; letter-spacing: 0.2em; color: var(--cream); font-weight: 700; margin-top: 14px; }
  .p4-meta { font-size: 11px; letter-spacing: 0.14em; color: var(--cream-3); margin-top: 6px; text-transform: uppercase; }
  .p4-info h3 { font-family: var(--display); font-size: clamp(34px, 4vw, 48px); color: var(--cream); margin: 0 0 16px; font-weight: 500; }
  .p4-info h3 em { font-style: italic; color: var(--accent); }
  .p4-desc { font-size: 15px; color: var(--cream-3); line-height: 1.65; margin: 0 0 28px; }
  .p4-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; padding: 20px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .p4-facts .k { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cream-4); margin-bottom: 6px; font-weight: 700; }
  .p4-facts .v { font-family: var(--display); font-style: italic; font-size: 28px; color: var(--cream); }
  @media (max-width: 800px) { .p4-grid { grid-template-columns: 1fr; gap: 30px; } }

  /* V5: Polaroid tilt */
  .p5-wrap { background: var(--ink); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 60px 24px; text-align: center; }
  .p5-head { max-width: 700px; margin: 0 auto 50px; }
  .p5-head p { font-family: var(--display); font-style: italic; font-size: 18px; color: var(--accent); margin: 0 0 12px; }
  .p5-head h2 { font-family: var(--display); font-size: clamp(36px, 5vw, 56px); line-height: 1; color: var(--cream); margin: 0; font-weight: 500; }
  .p5-head h2 em { font-style: italic; color: var(--accent); }
  .p5-row { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; margin-bottom: 50px; }
  .p5-polaroid { width: 280px; padding: 18px 18px 24px; background: #f4ead2; box-shadow: 0 24px 40px rgba(0,0,0,0.4), 0 6px 12px rgba(0,0,0,0.3); transition: transform .3s ease; }
  .p5-tilt-l { transform: rotate(-3deg); }
  .p5-tilt-r { transform: rotate(2.5deg); }
  .p5-polaroid:hover { transform: rotate(0deg) translateY(-6px); }
  .p5-img { height: 280px; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-style: italic; font-size: 72px; font-weight: 500; }
  .p5-img-chicken { background: linear-gradient(135deg, #d49162, #b06834); color: #f4ead2; }
  .p5-img-cab { background: linear-gradient(135deg, #6e4322, #3a2110); color: #d4a06c; }
  .p5-cap { font-family: var(--display); font-style: italic; font-size: 24px; color: #2a2520; margin: 16px 0 4px; }
  .p5-sub { font-family: ui-monospace, Menlo, monospace; font-size: 11px; letter-spacing: 0.12em; color: #6e6055; margin: 0; }
  .p5-foot { font-family: ui-monospace, Menlo, monospace; font-size: 11px; letter-spacing: 0.24em; color: var(--cream-4); text-transform: uppercase; margin: 0; }

  /* V0 Current */
  .p0-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .p0-row { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; padding: 50px 0; }
  .p0-pack { width: 240px; padding: 30px 20px; background: linear-gradient(180deg, #3a322a, #221d18); border: 1px solid rgba(229,133,66,0.3); border-radius: 4px; text-align: center; margin: 0 auto; }
  .p0-brand { font-family: var(--display); font-style: italic; font-size: 32px; color: var(--cream); margin-bottom: 4px; }
  .p0-fam { font-size: 9px; letter-spacing: 0.4em; color: var(--accent); margin-bottom: 14px; }
  .p0-window { height: 80px; border-radius: 4px; margin-bottom: 14px; }
