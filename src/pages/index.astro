---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Hero from '../components/Hero.astro';
import Trustbar from '../components/Trustbar.astro';
import BadgeStrip from '../components/BadgeStrip.astro';
import Products from '../components/Products.astro';
import Nutrition from '../components/Nutrition.astro';
import Protein from '../components/Protein.astro';
import FoodPairing from '../components/FoodPairing.astro';
import BehindScenes from '../components/BehindScenes.astro';
import TvSection from '../components/TvSection.astro';
import Founder from '../components/Founder.astro';
import WhereToBuy from '../components/WhereToBuy.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import A11yPanel from '../components/A11yPanel.astro';
import SiteScripts from '../components/SiteScripts.astro';
---

<Layout>
  <a class="skip-link" href="#main-content">Перейти до основного контенту</a>
  <div class="loader-bar" id="loader"></div>
  <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

  <Topbar />
  <MobileMenu />

  <main id="main-content">
    <Hero />
    <Trustbar />
    <BadgeStrip />
    <Products />
    <Nutrition />
    <Protein />
    <FoodPairing />
    <BehindScenes />
    <TvSection />
    <Founder />
    <WhereToBuy />
    <Faq />
    <Cta />
  </main>

  <Footer />
  <A11yPanel />
  <SiteScripts />
</Layout>
