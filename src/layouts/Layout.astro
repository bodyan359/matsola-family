---
import '../styles/global.css';
---
<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#2F2C28" />
<meta name="description" content="Matsola Family — курячі слайси з грецькими травами та кабаноси з натуральним копченням. 71% білків. Без сої. Без підсилювачів. Тільки м'ясо і спеції." />
<meta name="keywords" content="Matsola Family, Мацола, кабаноси, курячі слайси, м'ясні снеки, ППБ, Перша Приватна Броварня, натуральне копчення, високобілкові снеки, без сої" />
<meta name="author" content="Matsola Family · Перша Приватна Броварня" />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href="https://bodyan359.github.io/" />

<!-- Open Graph -->
<meta property="og:title" content="Matsola Family — Курячі Слайси & Кабаноси" />
<meta property="og:description" content="71% білків. Без сої. Без підсилювачів. Не змінюй ритм. Просто їм." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://bodyan359.github.io/" />
<meta property="og:site_name" content="Matsola Family" />
<meta property="og:locale" content="uk_UA" />
<meta property="og:image" content="https://bodyan359.github.io/og-image.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Matsola Family — м'ясні снеки. 71% білків. Не змінюй ритм. Просто їм." />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Matsola Family — Курячі Слайси & Кабаноси" />
<meta name="twitter:description" content="71% білків. Без сої. Без підсилювачів. Не змінюй ритм. Просто їм." />
<meta name="twitter:image" content="https://bodyan359.github.io/og-image.png" />

<title>Matsola Family — Курячі Слайси & Кабаноси · 71% білків · натуральне копчення</title>

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />
<link rel="manifest" href="manifest.json" />

<!-- Fonts: non-blocking async load (FCP optimization) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,700&family=Manrope:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;1,400;1,500&display=swap&subset=cyrillic,cyrillic-ext,latin" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,700&family=Manrope:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;1,400;1,500&display=swap&subset=cyrillic,cyrillic-ext,latin" rel="stylesheet"></noscript>

<!-- Motion (motion.dev) — vanilla animation layer; loaded async after parse, off the critical path -->
<script is:inline>document.documentElement.classList.add('js-anim');try{if(localStorage.getItem('matsola_theme')==='light')document.documentElement.setAttribute('data-theme','light');}catch(e){}setTimeout(function(){document.documentElement.classList.add('anim-failsafe')},3500);</script>
<!-- Schema.org structured data -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
