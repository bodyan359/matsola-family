      "foundingDate": "2025",
      "founder": {
        "@type": "Person",
        "name": "Андрій Мацола"
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Перша Приватна Броварня",
        "alternateName": "ППБ",
        "foundingDate": "2004",
        "url": "https://ppb.com.ua"
      },
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "UA",
        "addressLocality": "Львів"
      },
      "sameAs": [
        "https://ppb.com.ua"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://bodyan359.github.io/#website",
      "url": "https://bodyan359.github.io/",
      "name": "Matsola Family",
      "description": "Курячі слайси та кабаноси преміум-якості",
      "inLanguage": "uk-UA",
