        "fatContent": "38 g",
        "carbohydrateContent": "1.2 g",
        "servingSize": "100 g"
      },
      "hasVariant": [
        { "@type": "Product", "name": "Кабаноси Класичні", "sku": "matsola-cab-classic" },
        { "@type": "Product", "name": "Кабаноси Гострі з перцем", "sku": "matsola-cab-spicy" },
        { "@type": "Product", "name": "Кабаноси З пармезаном", "sku": "matsola-cab-parmesan" },
        { "@type": "Product", "name": "Кабаноси Особливі", "sku": "matsola-cab-special" }
      ],
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "priceCurrency": "UAH",
        "url": "https://bodyan359.github.io/#where",
        "seller": { "@id": "https://bodyan359.github.io/#organization" }
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://bodyan359.github.io/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "З чого зроблені продукти Matsola Family?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Тільки натуральне м'ясо, сіль і спеції. Жодної сої, крохмалю, підсилювачів смаку або рідкого диму. Курячі слайси — з куряного філе та грецьких трав. Кабаноси — зі свинини, яловичини та натуральних спецій."
          }
        },
        {
          "@type": "Question",
          "name": "Чому 71% білків у курячих слайсах?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Курячі слайси — це сушене куряче філе. Під час сушіння виходить волога, але білок залишається. Тому на 100г готового продукту такий високий відсоток. Це не добавки — це просто концентроване м'ясо."
          }
        },
        {
          "@type": "Question",
          "name": "Це та сама родина, що і пиво Мацола?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Так. Matsola Family — це м'ясна лінійка від родини Мацола, засновників Першої Приватної Броварні. ППБ — перше приватне пивне виробництво незалежної України, засноване у 2004 році у Львові."
          }
        },
        {
          "@type": "Question",
          "name": "Скільки зберігаються після відкриття?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Після відкриття — рекомендуємо з'їсти протягом 3 діб. Зберігати в прохолодному місці. Але, як правило, вони не залягаються надовго."
          }
        },
        {
          "@type": "Question",
          "name": "Коли з'являться нові смаки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ми вже працюємо над другою хвилею — вареними ковбасками та сосисками. Слідкуй за анонсами в Instagram @matsola_family."
          }
        }
      ]
    }
  ]
