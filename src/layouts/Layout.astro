        "url": "https://bodyan359.github.io/#where",
        "seller": { "@id": "https://bodyan359.github.io/#organization" }
      }
    },
    {
      "@type": "Product",
      "@id": "https://bodyan359.github.io/#cabanos",
      "name": "Кабаноси сирокопчені",
      "description": "Ковбаски сирокопчені преміум-класу. Чотири смаки: Класичні, Гострі з перцем, З пармезаном, Особливі. Натуральне копчення на твердих породах деревини.",
      "image": "https://bodyan359.github.io/og-image.png",
      "brand": { "@id": "https://bodyan359.github.io/#organization" },
      "category": "Cured meat snacks",
      "weight": { "@type": "QuantitativeValue", "value": 80, "unitCode": "GRM" },
