            </td>
            <td><span class="pt-n hi">24 г</span></td>
            <td><span class="pt-n hi">450</span></td>
            <td><span class="pt-n hi">1.2 г</span></td>
            <td><span class="pt-n hi">✓</span></td>
            <td><span class="pt-n hi">✓</span></td>
          </tr>
          <tr>
            <td><p class="pt-name">Горішки мікс</p></td>
            <td><span class="pt-n mid">18 г</span></td>
            <td><span class="pt-n mid">580</span></td>
            <td><span class="pt-n mid">12 г</span></td>
            <td><span class="pt-n mid">✓</span></td>
            <td><span class="pt-n mid">✓</span></td>
