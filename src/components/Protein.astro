<section class="section protein moments" id="protein">
  <div class="wrap">
    <div class="sec-head">
      <div class="reveal">
        <p class="s-eye">Чому Matsola</p>
        <h2 class="s-title">Чесний білок<br><em>у твоєму дні</em></h2>
      </div>
      <p class="s-lead reveal d1">Чесне порівняння — і моменти, коли снек якраз доречний.</p>
    </div>
    <div class="ptable-wrap reveal">
      <table class="ptable">
        <thead>
          <tr>
            <th>Продукт</th>
            <th>Білок</th>
