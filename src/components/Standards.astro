<section class="section standards" id="standards">
  <div class="wrap">
    <div class="sec-head">
      <div class="reveal">
        <p class="s-eye">Наші стандарти</p>
        <h2 class="s-title">Чесно про те,<br><em>що всередині</em></h2>
      </div>
      <p class="s-lead reveal d1">Ми не приховуємо склад дрібним шрифтом.</p>
    </div>

    <div class="stats-row">
      <div class="stat-card reveal"><div class="v"><span class="count" data-to="71" data-suffix="%">71%</span></div><div class="l">Білків у<br>курячих слайсах</div></div>
      <div class="stat-card reveal d1"><div class="v"><span class="count" data-to="0" data-suffix="&thinsp;г">0&thinsp;г</span></div><div class="l">Вуглеводів<br>у слайсах</div></div>
      <div class="stat-card reveal d2"><div class="v">4–5</div><div class="l">Інгредієнтів<br>у складі</div></div>
      <div class="stat-card reveal d3"><div class="v"><span class="count" data-to="100" data-suffix="%">100%</span></div><div class="l">Натуральне<br>м'ясо</div></div>
    </div>

    <div class="twocol">
      <div class="card-2 reveal">
        <div class="ttl"><span class="dot"></span>Clean Label</div>
        <p class="sub">Ми ставимо склад на лицьовій стороні пачки — бо нам нічого ховати.</p>
        <div class="ing-row">
          <div class="row"><span class="name">М'ясо</span><div class="bar"><div class="fill" data-w style="--w:85%;"></div></div><span class="pct">85%</span></div>
          <div class="row"><span class="name">Сіль</span><div class="bar"><div class="fill" data-w style="--w:8%;"></div></div><span class="pct">8%</span></div>
          <div class="row"><span class="name">Спеції</span><div class="bar"><div class="fill" data-w style="--w:7%;"></div></div><span class="pct">7%</span></div>
        </div>
        <div class="stamp">Читається за 5 секунд</div>
      </div>

      <div class="card-2 green reveal d1">
        <div class="ttl"><span class="dot"></span>Чому натуральне</div>
        <div class="check-list">
          <div class="row">
            <div class="icon">✓</div>
            <div class="text">
              <div class="t">Справжнє копчення</div>
              <div class="s">На твердих породах деревини — не рідкий дим</div>
            </div>
          </div>
          <div class="row">
            <div class="icon">✓</div>
            <div class="text">
              <div class="t">Без ГМО</div>
              <div class="s">Перевірена сировина від українських постачальників</div>
            </div>
          </div>
          <div class="row">
            <div class="icon">✓</div>
            <div class="text">
              <div class="t">Без хімії</div>
              <div class="s">Жодних Е-добавок, підсилювачів або консервантів</div>
            </div>
          </div>
          <div class="row">
            <div class="icon">✓</div>
            <div class="text">
              <div class="t">Виробництво в Україні</div>
              <div class="s">Повний контроль якості на кожному етапі</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
